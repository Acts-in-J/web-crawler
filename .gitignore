# Output (raw crawl results — large/PII, never commit)
output/
crawl_data/

# Fingerprints — ignore everything by default, whitelist only shareable recipe metadata
fingerprints/**
!fingerprints/
!fingerprints/*/
!fingerprints/*/profile.json
!fingerprints/*/recipe.md

# Python
__pycache__/
*.pyc
.venv/

# Local temp (repo-local pytest/temp — see conftest.py / pytest.ini)
.tmp/

# IDE
.vscode/
.idea/

# Auth/cookies/tokens — never commit (overrides whitelists above)
naver_auth.json
**/cookies*.json
**/auth*.json
**/*token*.json
**/*secret*
.DS_Store

# 사이트 수집 아카이브 — 독립 git 저장소 + 대용량 tar.gz (모노레포에서 제외)
sites/

# sync_public.py 가 자동 관리하는 public 레포 작업본 (파생물 — 언제든 삭제 가능)
.publish-mirror/
